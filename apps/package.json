{
  "name": "crossfeed",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "$npm_execpath run build && vite preview",
    "deploy": "$npm_execpath run build && wrangler d1 migrations apply DB --remote && wrangler deploy",
    "deploy:preview": "CLOUDFLARE_ENV=preview $npm_execpath run build && wrangler d1 migrations apply DB --remote --env preview && wrangler deploy --env preview",
    "cf-typegen": "wrangler types --include-runtime=false --strict-vars=false",
    "typecheck": "tsc",
    "test": "vitest run"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.135.0",
    "@base-ui/react": "^1.9.0",
    "@fontsource-variable/schibsted-grotesk": "^5.3.0",
    "@hono/zod-openapi": "^1.6.3",
    "@modelcontextprotocol/server": "2.3.1",
    "@simplewebauthn/browser": "^14.0.0",
    "@simplewebauthn/server": "^14.0.3",
    "agents": "0.28.1",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "hono": "^4.13.13",
    "lucide-react": "^1.61.0",
    "postal-mime": "^4.0.11",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "shadcn": "^4.22.1",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.64.0",
    "@cloudflare/vitest-plugin": "^1.4.4",
    "@cloudflare/workers-types": "^5.20261016.1",
    "@msw/cloudflare": "^0.2.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "msw": "^3.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vite-ssr-components": "^0.8.0",
    "vitest": "^5.0.5",
    "wrangler": "^4.151.1"
  }
}
