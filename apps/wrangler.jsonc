{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "crossfeed",
  "account_id": "f0621d6622ac79af0e8e6f3520f78063",
  "compatibility_date": "2026-10-12",
  "compatibility_flags": ["nodejs_compat"],
  "main": "./src/index.tsx",
  "observability": { "enabled": true },
  "triggers": { "crons": ["0 12 * * *"] },
  "vars": {
    "QLOO_BASE_URL": "https://hackathon.api.qloo.com",
    "QLOO_DAILY_CALL_CAP": "1000",
    "QLOO_TIMEOUT_MS": "20000",
    "QLOO_RETRY_DELAYS_MS": "1000,3000",
    "QLOO_MIN_INTERVAL_MS": "400",
    // A call still waiting this long is shown as slow: the TRD's worst case per Qloo call.
    "QLOO_SLOW_MS": "8000",
    "ANTHROPIC_BASE_URL": "https://api.anthropic.com",
    // "on" shows the guest pitch flow; "off" hides it. #57 switched it on after its live check.
    "GUEST_PITCHES": "on",
    // A new session opens on the sample network (TRD demo data); tests turn it off.
    "SAMPLE_NETWORK": "on"
  },
  "secrets": { "required": ["QLOO_API_KEY", "ANTHROPIC_API_KEY"] },
  "durable_objects": {
    "bindings": [
      { "name": "CrossfeedAgent", "class_name": "CrossfeedAgent" },
      { "name": "QlooGateway", "class_name": "QlooGateway" }
    ]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["CrossfeedAgent", "QlooGateway"] }]
}
